# Deixe em branco para usar o proxy do Next.js (recomendado para desenvolvimento).
# Só defina se quiser apontar para um backend em outro host.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:5001/api

# Variável server-side: URL do Flask para o proxy do Next.js (não exposta ao browser)
FLASK_API_URL=http://localhost:5001

NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
